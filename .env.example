# Copia este archivo a .env y rellena los valores. NUNCA subas .env a GitHub.

# --- PostgreSQL ---
POSTGRES_USER=kb_user
POSTGRES_PASSWORD=kb_password
POSTGRES_DB=knowledge_base
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Auth (fase 1) ---
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
JWT_EXPIRE_MINUTES=60

# --- App ---
CORS_ORIGINS=http://localhost:4200

# --- Ingesta (fase 2) ---
MAX_UPLOAD_MB=20
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=80

# --- Chat RAG (fase 4) ---
# Pon "none" si usas un modelo de razonamiento que no acepta temperature
OPENAI_TEMPERATURE=0
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.2
RAG_HISTORY_MESSAGES=6
